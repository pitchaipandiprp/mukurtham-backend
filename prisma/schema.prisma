// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model Roles {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt

  name       String    @unique(map: "roles_name_unique") @db.VarChar(10)
  code       String    @unique(map: "roles_code_unique") @db.VarChar(10)

  is_active  Int       @default(1) @db.UnsignedTinyInt

  created_at DateTime? @db.DateTime
  updated_at DateTime? @db.DateTime

  users      Users[]

  @@map("roles")
}

model Users {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt

  role_id        Int       @db.UnsignedInt

  name           String    @db.VarChar(100)
  email          String    @unique(map: "users_email_unique") @db.VarChar(100)
  mobile         String    @unique(map: "users_mobile_unique") @db.VarChar(20)
  password       String    @db.VarChar(200)

  refresh_token  String?   @db.Text

  status         Int       @default(0) @db.UnsignedTinyInt

  created_by     Int?      @db.UnsignedInt
  updated_by     Int?      @db.UnsignedInt

  created_at     DateTime? @db.DateTime
  updated_at     DateTime? @db.DateTime

  role           Roles     @relation(fields: [role_id], references: [id])

  service_reviews ServiceReview[]

  @@index([role_id], map: "idx_users_role_id")

  @@map("users")
}

model OtpRequest {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt

  mobile       String    @db.VarChar(20)
  otp_hash     String    @db.Text

  expires_at   DateTime  @db.DateTime
  verified_at  DateTime? @db.DateTime

  attempts     Int       @default(0) @db.UnsignedInt

  created_at   DateTime? @db.DateTime

  @@index([mobile], map: "idx_otp_request_mobile")

  @@map("otp_request")
}

model Category {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @unique(map: "categories_name_unique") @db.VarChar(50)
  slug_url    String?  @db.VarChar(200)
  icon        String?  @db.VarChar(100)
  image       String?  @db.VarChar(250)
  color       String?  @db.VarChar(20)
  sort_order  Int      @default(0) @db.UnsignedInt
  status      Int      @default(1) @db.UnsignedTinyInt
  created_by  Int?     @db.UnsignedInt
  updated_by  Int?     @db.UnsignedInt
  created_at  DateTime? @db.DateTime
  updated_at  DateTime? @db.DateTime

  categoryServices CategoryService[]
  facilities       Facility[]

  @@map("categories")
}

model Facility {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  category_id Int       @db.UnsignedInt

  name        String    @db.VarChar(100)

  status      Int       @default(1) @db.UnsignedTinyInt

  created_by  Int?      @db.UnsignedInt
  updated_by  Int?      @db.UnsignedInt

  created_at  DateTime? @db.DateTime
  updated_at  DateTime? @db.DateTime

  category    Category  @relation(fields: [category_id], references: [id])

  @@map("facilities")
}

model State {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt

  name        String    @unique(map: "states_name_unique") @db.VarChar(100)

  status      Int       @default(1) @db.UnsignedTinyInt

  created_by  Int?      @db.UnsignedInt
  updated_by  Int?      @db.UnsignedInt

  created_at  DateTime? @db.DateTime
  updated_at  DateTime? @db.DateTime

  localities       Locality[]
  categoryServices CategoryService[]

  @@map("states")
}

model City {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  state_id    Int       @db.UnsignedInt

  name        String    @db.VarChar(100)

  is_popular  Int       @default(0) @db.UnsignedTinyInt
  status      Int       @default(1) @db.UnsignedTinyInt

  created_by  Int?      @db.UnsignedInt
  updated_by  Int?      @db.UnsignedInt

  created_at  DateTime? @db.DateTime
  updated_at  DateTime? @db.DateTime

  localities       Locality[]
  categoryServices CategoryService[]

  @@map("cities")
}

model Locality {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  state_id    Int       @db.UnsignedInt
  city_id     Int       @db.UnsignedInt

  name        String    @db.VarChar(100)

  status      Int       @default(1) @db.UnsignedTinyInt

  created_by  Int?      @db.UnsignedInt
  updated_by  Int?      @db.UnsignedInt

  created_at  DateTime? @db.DateTime
  updated_at  DateTime? @db.DateTime

  state             State             @relation(fields: [state_id], references: [id])
  city              City              @relation(fields: [city_id], references: [id])

  categoryServices CategoryService[]

  @@index([state_id], map: "idx_localities_state_id")
  @@index([city_id], map: "idx_localities_city_id")
  
  @@map("localities")
}

model CategoryService {
  id                    Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id               Int       @db.UnsignedInt
  category_id           Int       @db.UnsignedInt
  state_id              Int?      @db.UnsignedInt
  city_id               Int?      @db.UnsignedInt
  locality_id           Int?      @db.UnsignedInt

  service_name          String    @db.VarChar(250)
  service_mobile        String?   @db.VarChar(100)
  service_email         String?   @db.VarChar(100)
  service_experience    String?   @db.VarChar(100)
  service_description   String?   @db.Text
  service_address       String?   @db.Text
  service_banner_image  String?   @db.VarChar(250)

  capacity              Int       @default(0) @db.UnsignedInt
  number_of_rooms       Int       @default(0) @db.UnsignedInt
  completed_events      String?   @db.VarChar(100)

  facility_ids          String?   @db.VarChar(100)

  latitude              String?   @db.VarChar(100)
  longitude             String?   @db.VarChar(100)

  pricing_type          String?   @db.VarChar(50)

  amount                Decimal   @default(0.00) @db.Decimal(10, 2)
  discount              Decimal   @default(0.00) @db.Decimal(10, 2)
  tax_percentage        Decimal   @default(0.00) @db.Decimal(5, 2)
  tax_amount            Decimal   @default(0.00) @db.Decimal(10, 2)
  final_amount          Decimal   @default(0.00) @db.Decimal(10, 2)

  verification_status   Json?
  status                Int       @default(0) @db.UnsignedTinyInt

  created_by            Int?      @db.UnsignedInt
  updated_by            Int?      @db.UnsignedInt

  created_at            DateTime? @db.DateTime
  updated_at            DateTime? @db.DateTime

  category                    Category  @relation(fields: [category_id], references: [id])
  state                       State?    @relation(fields: [state_id], references: [id])
  city                        City?     @relation(fields: [city_id], references: [id])
  locality                    Locality? @relation(fields: [locality_id], references: [id])

  gallery Gallery[]
  service_reviews ServiceReview[]
  service_dates ServiceDate[]
  service_highlights ServiceHighlight[]

  @@index([category_id], map: "idx_category_services_category_id")
  @@index([user_id], map: "idx_category_services_user_id")
  @@index([locality_id], map: "idx_category_services_locality_id")

  @@map("category_services")
}

model Gallery {
  id                  Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id             Int      @db.UnsignedInt
  category_service_id Int      @db.UnsignedInt
  gallery_type        String   @db.VarChar(10)
  occasion_type       String?  @db.VarChar(100)
  gallery_image       String?  @db.VarChar(250)
  gallery_video       String?  @db.VarChar(250)
  status              Int      @default(0) @db.UnsignedTinyInt
  created_by          Int?     @db.UnsignedInt
  updated_by          Int?     @db.UnsignedInt
  created_at          DateTime?
  updated_at          DateTime?

  category_service    CategoryService  @relation(fields: [category_service_id], references: [id])

  @@index([user_id], map: "idx_gallery_user_id")
  @@index([category_service_id], map: "idx_gallery_category_service_id")
  @@index([gallery_type], map: "idx_gallery_gallery_type")
  @@index([occasion_type], map: "idx_gallery_occasion_type")

  @@map("gallery")
}


model ServiceReview {
  id                  Int      @id @default(autoincrement()) @db.UnsignedInt

  user_id             Int      @db.UnsignedInt
  category_service_id Int      @db.UnsignedInt

  rating              Int      @default(0) @db.UnsignedTinyInt
  review_title        String?  @db.VarChar(250)
  review_description  String?  @db.Text

  status              Int      @default(0) @db.UnsignedTinyInt

  created_by          Int?     @db.UnsignedInt
  updated_by          Int?     @db.UnsignedInt

  created_at          DateTime? @db.DateTime
  updated_at          DateTime? @db.DateTime

  user Users  @relation(fields: [user_id], references: [id])
  category_service    CategoryService  @relation(fields: [category_service_id], references: [id])

  @@index([user_id], map: "idx_service_reviews_user_id")
  @@index([category_service_id], map: "idx_service_reviews_category_service_id")
  @@index([rating], map: "idx_service_reviews_rating")

  @@map("service_reviews")
}

model ServiceDate {
  id                    Int           @id @default(autoincrement()) @db.UnsignedInt
  user_id               Int           @db.UnsignedInt
  category_service_id   Int?          @db.UnsignedInt
  date_type             String?       @db.VarChar(50)
  event_name            String?       @db.VarChar(100)
  from_date             DateTime?     @db.Date
  to_date               DateTime?     @db.Date

  status                Int           @default(0) @db.UnsignedTinyInt
  created_by            Int?          @db.UnsignedInt
  updated_by            Int?          @db.UnsignedInt
  created_at            DateTime?     @db.DateTime
  updated_at            DateTime?     @db.DateTime

  category_service    CategoryService?  @relation(fields: [category_service_id], references: [id])

  @@index([user_id], map: "idx_service_dates_user_id")
  @@index([category_service_id], map: "idx_service_dates_category_service_id")
  @@index([date_type], map: "idx_service_dates_date_type")

  @@map("service_dates")
}

model ServiceHighlight {
  id                  Int      @id @default(autoincrement()) @db.UnsignedInt

  user_id             Int      @db.UnsignedInt
  category_service_id Int      @db.UnsignedInt

  highlight           String  @db.VarChar(250)

  status              Int      @default(0) @db.UnsignedTinyInt

  created_by          Int?     @db.UnsignedInt
  updated_by          Int?     @db.UnsignedInt

  created_at          DateTime? @db.DateTime
  updated_at          DateTime? @db.DateTime

  category_service    CategoryService?  @relation(fields: [category_service_id], references: [id])

  @@index([user_id], map: "idx_service_highlights_user_id")
  @@index([category_service_id], map: "idx_service_highlights_category_service_id")

  @@map("service_highlights")
}
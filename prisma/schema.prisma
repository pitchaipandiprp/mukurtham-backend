// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model Roles {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(10)
  code       String    @unique @db.VarChar(10)
  is_active  Boolean   @default(true) @db.TinyInt
  created_at DateTime?
  updated_at DateTime?

  users      Users[]
}

model Users {
  id            Int       @id @default(autoincrement())
  role_id       Int
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(100)
  mobile        String    @unique @db.VarChar(20)
  password      String    @db.VarChar(200)
  status        Int       @default(0) @db.TinyInt
  refresh_token String?   @db.Text
  created_by    Int?
  created_at    DateTime?
  updated_by    Int?
  updated_at    DateTime?

  role Roles @relation(fields: [role_id], references: [id])
}

model OtpRequest {
  id          Int       @id @default(autoincrement())
  mobile      String    @db.VarChar(20)
  otp_hash    String    @db.Text
  expires_at  DateTime
  verified_at DateTime?
  attempts    Int       @default(0)
  created_at  DateTime?

  @@map("otp_request")
  @@index([mobile])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  slug_url    String?   @db.VarChar(200)
  icon        String?   @db.VarChar(100)
  image       String?   @db.VarChar(250)
  color    String?   @db.VarChar(20)
  status      Int       @default(1) @db.TinyInt
  sort_order  Int?      
  created_by  Int?      
  updated_by  Int?      
  created_at  DateTime?  @db.DateTime(0)
  updated_at  DateTime?  @db.DateTime(0)

  categoryServices CategoryService[]

  @@map("categories")
}

model State {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  status      Int       @default(1) @db.TinyInt
  created_by  Int?      
  updated_by  Int?      
  created_at  DateTime?  @db.DateTime(0)
  updated_at  DateTime?  @db.DateTime(0)

  localities       Locality[]
  categoryServices CategoryService[]

  @@map("states")
}

model City {
  id          Int       @id @default(autoincrement())
  state_id    Int
  name        String    @db.VarChar(100)
  status      Int       @default(1) @db.TinyInt
  created_by  Int?      
  updated_by  Int?      
  created_at  DateTime?  @db.DateTime(0)
  updated_at  DateTime?  @db.DateTime(0)

  localities       Locality[]
  categoryServices CategoryService[]

  @@map("cities")
}

model Locality {
  id          Int       @id @default(autoincrement())
  state_id    Int
  city_id     Int
  name        String    @db.VarChar(100)
  is_popular  Int       @default(0) @db.TinyInt
  status      Int       @default(1) @db.TinyInt
  created_by  Int?      
  updated_by  Int?      
  created_at  DateTime?  @db.DateTime(0)
  updated_at  DateTime?  @db.DateTime(0)

  state             State             @relation(fields: [state_id], references: [id])
  city              City              @relation(fields: [city_id], references: [id])

  categoryServices CategoryService[]
  
  @@map("localities")
}

model CategoryService {
  id                          Int      @id @default(autoincrement())
  user_id                     Int
  category_id                 Int
  state_id                    Int?
  city_id                     Int?
  locality_id                 Int?
  service_name                String    @db.VarChar(250)
  service_description         String?   @db.Text
  service_address             String?   @db.Text
  service_banner_image        String?   @db.VarChar(250)
  capacity                    String?   @db.VarChar(100)
  number_of_rooms             Int?      @default(0)
  car_parking                 String?   @db.VarChar(10)
  ac_available                String?   @db.VarChar(10)
  latitude                    String?   @db.VarChar(100)
  longitude                   String?   @db.VarChar(100)
  pricing_type                String?   @db.VarChar(50)
  amount                      Float     @default(0)
  discount                    Float     @default(0)
  tax_percentage              Float     @default(0)
  final_amount                Float     @default(0)
  status                      Int       @default(0) @db.TinyInt

  category                    Category  @relation(fields: [category_id], references: [id])
  state                       State?    @relation(fields: [state_id], references: [id])
  city                        City?     @relation(fields: [city_id], references: [id])
  locality                    Locality? @relation(fields: [locality_id], references: [id])

  @@map("category_services")
}